# Server only. Do not prefix these with VITE_.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# automatic_tax is on only when this is exactly true. Leave unset or false
# until Stripe Tax is enabled on the account. Without an active tax
# registration, Stripe does not collect tax even if this is true.
STRIPE_AUTOMATIC_TAX=false

# Founding prices (first 10 families). Live IDs are the fallback in code.
STRIPE_PRICE_FOUNDATION=price_1Sv7xjLm2d84XGYAGq7oO5FV
# Quoted privately. Not on the checkout allowlist.
# STRIPE_PRICE_FOUNDATION_PLUS=price_1Sv801Lm2d84XGYA51lEDMgU
STRIPE_PRICE_ENHANCED=price_1Sv80bLm2d84XGYApQDFLjwx
STRIPE_PRICE_CONCIERGE=price_1Sv84XLm2d84XGYAljWslj3i
